{
    // Start VGrid from VS Code: Terminal > Run Task... (or Ctrl+Shift+B for "Run VGrid")
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run VGrid",
            "type": "shell",
            "command": "cmd /c run-vgrid.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Open another VGrid window",
            "type": "shell",
            "command": "cmd /c open-another-window.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Run OCPP server",
            "type": "shell",
            "command": "cmd /c run-ocpp-server.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "presentation": { "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "Run charger simulator",
            "type": "shell",
            "command": "cmd /c run-charger-simulator.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
